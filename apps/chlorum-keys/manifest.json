{
  "manifest_version": 2,
  "name": "Chlorum Keys",
  "version": "0.4.0",
  "description": "Use every web page without a mouse: arrows move between buttons and links, F shows a letter on each one.",
  "browser_specific_settings": {
    "gecko": { "id": "keys@chlorum", "strict_min_version": "115.0" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keys.js"],
      "css": ["keys.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
