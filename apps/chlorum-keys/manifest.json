{
  "manifest_version": 2,
  "name": "Chlorum Keys",
  "version": "0.7.0",
  "description": "Use every web page without a mouse: arrows move between buttons and links, F shows a letter on each one, Esc leaves a text box, ? shows the keys.",
  "browser_specific_settings": {
    "gecko": {
      "id": "keys@chlorum",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "keys.js"
      ],
      "css": [
        "keys.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Chlorum Keys",
    "default_popup": "options.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
