// Chlorum's niri (session): no panels, no desktop, no window juggling.
// The Chlorum shell decides what is on screen (one app, or two side by side)
// and moves windows through niri's IPC. Apps not on screen wait on the hidden
// "shelf" workspace. @...@ values are filled in when the session starts.

input {
    keyboard {
        xkb {
            layout "@LAYOUT@"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 300
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
    }
    // keyboard first: a pointer that moves never changes the app with the keys
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 3000
}

layout {
    gaps 0
    center-focused-column "never"
    default-column-width { proportion 1.0; }
    focus-ring { off; }
    border { off; }
    shadow { off; }
    tab-indicator { off; }
    insert-hint { off; }
    background-color "#000000"
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

// "home" stays empty: Home shows there, over the live wallpaper
workspace "home"
workspace "stage"
workspace "shelf"

prefer-no-csd
// straight into Library's Screenshots collection
screenshot-path "~/Library/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

gestures {
    hot-corners {
        off
    }
}

// Every new window starts on the stage, filling it; the shell does the rest.
window-rule {
    open-on-workspace "stage"
    open-maximized false
    default-column-width { proportion 1.0; }
    clip-to-geometry true
}

// Small windows that belong to an app float over it, centred.
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Library's open/save window floats above the app that asked for it
window-rule {
    match app-id="^chlorum-picker$"
    open-floating true
    default-column-width { proportion 0.78; }
    default-window-height { proportion 0.8; }
}

animations {
    window-open {
        duration-ms 220
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 160
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

binds {
    // The PlayStation button: the system menu over any app.
    Super+Super_L repeat=false { spawn "chlorum" "msg" "super"; }
    Super+Super_R repeat=false { spawn "chlorum" "msg" "super"; }

    // Two apps side by side
    Super+Left repeat=false { spawn "chlorum" "msg" "left"; }
    Super+Right repeat=false { spawn "chlorum" "msg" "right"; }
    Super+bracketleft { spawn "chlorum" "msg" "shrink"; }
    Super+bracketright { spawn "chlorum" "msg" "grow"; }
    Super+X repeat=false { spawn "chlorum" "msg" "swap"; }
    Super+Return repeat=false { spawn "chlorum" "msg" "template"; }
    Super+H repeat=false { spawn "chlorum" "msg" "home"; }
    Super+L repeat=false allow-when-locked=true { spawn "chlorum" "lock"; }
    // move the mouse pointer with the arrows (laptops); again to stop
    Super+M repeat=false { spawn "chlorum" "pointer"; }

    // The numpad is the mouse (Num Lock does not matter): 8 4 6 2 and the
    // corners move it (hold to glide), 5 clicks, / right click, * middle,
    // 0 holds the button for dragging, - and + scroll.
    KP_Up { spawn "chlorum" "mouse" "go" "up"; }
    KP_Down { spawn "chlorum" "mouse" "go" "down"; }
    KP_Left { spawn "chlorum" "mouse" "go" "left"; }
    KP_Right { spawn "chlorum" "mouse" "go" "right"; }
    KP_Home { spawn "chlorum" "mouse" "go" "upleft"; }
    KP_Prior { spawn "chlorum" "mouse" "go" "upright"; }
    KP_End { spawn "chlorum" "mouse" "go" "downleft"; }
    KP_Next { spawn "chlorum" "mouse" "go" "downright"; }
    KP_Begin repeat=false { spawn "chlorum" "mouse" "click"; }
    KP_Divide repeat=false { spawn "chlorum" "mouse" "right"; }
    KP_Multiply repeat=false { spawn "chlorum" "mouse" "middle"; }
    KP_Insert repeat=false { spawn "chlorum" "mouse" "drag"; }
    KP_Subtract { spawn "chlorum" "mouse" "scroll" "up"; }
    KP_Add { spawn "chlorum" "mouse" "scroll" "down"; }

    // Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioStop allow-when-locked=true { spawn "playerctl" "stop"; }

    // every shortcut, on screen
    Super+Slash repeat=false { show-hotkey-overlay; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Ways out if something goes wrong: a terminal, and log out
    Ctrl+Alt+T repeat=false { spawn "cosmic-term"; }
    Ctrl+Alt+Delete repeat=false { quit; }

    // screenshots: the screen, a part you choose, or the app in front
    Print { screenshot-screen; }
    Shift+Print { screenshot; }
    Alt+Print { screenshot-window; }
}
